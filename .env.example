APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jerusalem
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srvonclick-db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Login ---
# The name of the Passport personal access client and of the cookie that holds the token.
ACCESS_TOKEN_NAME=ServOnClickAccessToken

# The servers log in through ADFS (ADFS/AuthController.php replaces AuthController.php in the image).
ADFS_URL=
ADFS_USER=
ADFS_PASSWORD=

# Vatican - the people directory: the login asks it for the ID number of a personal number.
VATICAN_URL=
VATICAN_TOKEN=

# --- Bucket (booking images and files) ---
# "minio" locally, "s3" on the servers (the AWS_* keys above).
STORAGE_SERVICE=minio
STORAGE_DIR=public
TEMP_URL_LIFETIME=30
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=srvonclick-bucket
MINIO_ENDPOINT=http://localhost:9000
MINIO_URL=
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Optional: PROD_STAGE=false outside production (the bucket name is then part of the object keys),
# RATE_LIMITATION=100 (requests per minute).

# --- Import (the b2r files the mobile side drops in the bucket) ---
# Folders of the bucket (all names below can be changed; the bucket itself is the disk STORAGE_SERVICE picks):
#   import-json/    the json files, both kinds together: SrvOnClick_b2r_export_bookings_*.json and SrvOnClick_b2r_application_logs_*.json
#   loaded-json/    a json file that was saved in the database moves here (a backup of what was read)
#   import-files/   the files and images: SrvOnClickFiles_<stored name>.<ext>. The stored name is the one the booking json gives, so a file is
#                   saved once its booking is (a file no booking names yet waits here)
#   files/          where the bookings serve their files and images from, all of them together: a copy of every saved file
#   loaded-files/   a received file that was saved moves here (a backup, like loaded-json)
# Only names with the system prefixes (SrvOnClick_ for json, SrvOnClickFiles_ for files) are read; anything else in those folders is left alone.
# One command per place the files come from, after the colon. The two json commands read the file in the command (command -> trait -> service) and
# queue its rows as chunk jobs - ImportBookingJsonChunkJob, ImportApplicationLogJsonChunkJob - that `php artisan queue:work` saves in the database;
# a log waits for its booking, so import the bookings first. --sync saves the rows right now in the command (no worker) and prints what it did:
#   importBookingJson:bucket         import-json -> chunk jobs -> database; the file -> loaded-json  (was importBookingJson:mysql, which still works)
#   importApplicationLogJson:bucket  import-json -> chunk jobs -> database; the file -> loaded-json  (was importApplicationLogJson:mysql)
#   importFile:bucket                import-files -> database (file / image rows) -> files + loaded-files (queues ImportFileBucketJob)
# GET /api/test-import (super_admin) does all three right now and returns the imported data. The ":ftp" versions, which take the files from the
# digital hatch first, are in the section below.
IMPORT_JSON_ENABLED=true
# IMPORT_JSON=import-json
# LOADED_JSON_FOLDER_NAME=loaded-json
# IMPORT_FILES_FOLDER_NAME=import-files
# LOADED_FILES_FOLDER_NAME=loaded-files
# ATTACHMENTS_FOLDER_NAME=files
# Both kinds of json file are read straight from import-json. To read them from subfolders of it, name the subfolders:
# BOOKING_DATA_JSON_FOLDER_NAME=
# APPLICATION_LOG_JSON_FOLDER_NAME=
# IMPORT_BOOKING_JSON_CHUNK_SIZE=100
# IMPORT_APPLICATION_LOG_JSON_CHUNK_SIZE=500
# IMPORT_BOOKING_JSON_CRON="*/5 * * * *"
# IMPORT_APPLICATION_LOG_JSON_CRON="1-59/5 * * * *"
# IMPORT_FILE_CRON="4-59/5 * * * *"

# --- Export (the r2b files this system writes back for the mobile side) ---
# The decisions made here (status changes, corrected date/time values) are written to export-json/booking-status and export-json/booking-values
# every two minutes by `exportBookingStatusJson:mysql` (no queue worker needed). EXPORT_JSON_ENABLED=false keeps them waiting in the database.
EXPORT_JSON_ENABLED=true
# The mobile importer reads ONE status file per day by its exact name. Its configuration says r2b, its importer looks for b2r: set the prefix it really reads.
# EXPORT_BOOKING_STATUS_PREFIX=SrvOnClick_r2b_booking_status_
# The day in that file name is counted in this timezone (empty = the application's, UTC): set the one the mobile importer uses, e.g. Asia/Jerusalem.
# EXPORT_JSON_TIMEZONE=
# EXPORT_JSON=export-json
# BOOKING_STATUS_JSON_FOLDER_NAME=booking-status
# BOOKING_VALUES_JSON_FOLDER_NAME=booking-values
# EXPORT_JSON_CRON="*/2 * * * *"
# EXPORT_JSON_MAX_ATTEMPTS=8

# --- The configuration channel (r2b "system_config" files) ---
# Every change of the form structure, the options, the statements, the settings and a new unit is written to export-json/system-config, oldest first, in
# the same round. The mobile side needs an importer for them (docs/mobile-sync-contract.md). With the channel off the changes are kept in the database
# and go out when it is switched on.
SYNC_CONFIG_CHANNEL_ENABLED=true
# SYSTEM_CONFIG_JSON_FOLDER_NAME=system-config

# --- The digital hatch (FTP between this system and the mobile side) ---
# The bucket stays the working area; these commands move the files between it and the FTP, and do nothing while HATCH_ENABLED=false. A queue
# worker (`php artisan queue:work`) must run: the sends and the file import queue one job each, the two json imports queue their rows as chunk jobs.
# To run one alone, right now, and see what it did, add --sync (`php artisan digital-hatch:send-users --sync`, `php artisan importBookingJson:ftp --sync`).
#   digital-hatch:send-users          r2b  bucket -> FTP  SrvOnClick_r2b_users_<date>.json (every 2 minutes; SendHatchUsersJob)
#   digital-hatch:send-booking-status r2b  bucket -> FTP  SrvOnClick_r2b_booking_status_<date>.json (every 2 minutes; SendHatchBookingStatusJob)
#   importBookingJson:ftp             b2r  FTP -> bucket import-json -> chunk jobs -> database; the file -> loaded-json: SrvOnClick_b2r_export_bookings_<date-time>.json (every 5)
#   importApplicationLogJson:ftp      b2r  the same for SrvOnClick_b2r_application_logs_<date-time>.json (every 5)
#   importFile:ftp                    b2r  FTP -> bucket import-files -> database -> files + loaded-files: SrvOnClickFiles_<stored name>.<pdf|docx|xlsx|pptx|jpg|png|...>
#                                          (every 5; ImportFileFtpJob)
# digital_hatch_fetched_files remembers every b2r file that was taken in (from the FTP, the local folder or the bucket) and digital_hatch_sent_files
# every r2b version that was written (to the bucket, the FTP or the local folder). --force sends (r2b) or takes (b2r) a file again even if the same
# one was sent / taken before. Needs the PHP ftp extension.
HATCH_ENABLED=false
HATCH_FTP_HOST=
HATCH_FTP_USERNAME=
HATCH_FTP_PASSWORD=
# FTP_ROOT=
# RED_TO_BLACK_FTP_PATH=/R2B/Tikshoret-R2B-Prod/
# BLACK_TO_RED_FTP_PATH=/Tikshoret-B2R-Prod/
# BLACK_TO_RED_FTP_ATTACHMENTS_PATH=/DigitalFiles-B2R-Prod/
# Local testing without an FTP: the two send commands write the r2b files straight into this folder (created when missing) and never touches the FTP.
# Use FORWARD slashes: in a .env value a backslash can start an escape ("...\r2b" would contain a carriage return). Leave it empty on dev / prod.
# DIGITAL_HATCH_EXPORT_PATH=C:/Users/<you>/Downloads/srvonclick-project/tikshort-ftp/r2b
# The same for the b2r side: the three :ftp import commands read the json files (SrvOnClick_b2r_...) and the files and images (SrvOnClickFiles_...)
# from these folders instead of the FTP. They must exist (they are not created) and are never written to or cleaned.
# DIGITAL_HATCH_IMPORT_PATH=C:/Users/<you>/Downloads/srvonclick-project/tikshort-ftp/b2r
# DIGITAL_HATCH_IMPORT_FILES_PATH=C:/Users/<you>/Downloads/srvonclick-project/tikshort-ftp/b2r_files
# HATCH_FORMAT=json
# Keep these unless the mobile side renamed its files: the importers look for SrvOnClick_b2r_ and AttachmentService for SrvOnClickFiles_.
# HATCH_PREFIX=SrvOnClick
# HATCH_FILES_PREFIX=SrvOnClickFiles
# USERS_JSON_FOLDER_NAME=users
# DIGITAL_HATCH_SEND_USERS_CRON="1-59/2 * * * *"
# DIGITAL_HATCH_SEND_BOOKING_STATUS_CRON="1-59/2 * * * *"
# DIGITAL_HATCH_SEND_USERS_JOB_TRIES=3
# DIGITAL_HATCH_SEND_USERS_JOB_BACKOFF=60
# DIGITAL_HATCH_SEND_USERS_JOB_TIMEOUT=300
# DIGITAL_HATCH_SEND_BOOKING_STATUS_JOB_TRIES=3
# DIGITAL_HATCH_SEND_BOOKING_STATUS_JOB_BACKOFF=60
# DIGITAL_HATCH_SEND_BOOKING_STATUS_JOB_TIMEOUT=300
# DIGITAL_HATCH_IMPORT_BOOKING_CRON="2-59/5 * * * *"
# DIGITAL_HATCH_IMPORT_APPLICATION_LOG_CRON="3-59/5 * * * *"
# DIGITAL_HATCH_IMPORT_FILE_CRON="4-59/5 * * * *"
# The two file import jobs (importFile:bucket and importFile:ftp) share these. The chunk jobs of the json imports have their own
# (IMPORT_BOOKING_JSON_JOB_* and IMPORT_APPLICATION_LOG_JSON_JOB_*: TRIES, BACKOFF, TIMEOUT): a log chunk waits BACKOFF seconds for its booking, TRIES times.
# IMPORT_JOB_TRIES=3
# IMPORT_JOB_BACKOFF=60
# IMPORT_JOB_TIMEOUT=900

# --- Files and images of the bookings ---
# The booking json only names them (SrvOnClickFiles_<stored name>, no extension). Their bytes are received in IMPORT_FILES_FOLDER_NAME, and importFile
# saves them: it gives the file / image row of the booking the key of a copy in ATTACHMENTS_FOLDER_NAME (the folder the bookings serve them from) and
# moves the received file to LOADED_FILES_FOLDER_NAME. The three folder names are in the import section above.

VITE_APP_NAME="${APP_NAME}"
