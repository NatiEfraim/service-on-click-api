APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jerusalem
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srvonclick-db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Login ---
# The name of the Passport personal access client and of the cookie that holds the token.
ACCESS_TOKEN_NAME=ServOnClickAccessToken

# The servers log in through ADFS (ADFS/AuthController.php replaces AuthController.php in the image).
ADFS_URL=
ADFS_USER=
ADFS_PASSWORD=

# Vatican - the people directory: the login asks it for the ID number of a personal number.
VATICAN_URL=
VATICAN_TOKEN=

# --- Bucket (booking images and files) ---
# "minio" locally, "s3" on the servers (the AWS_* keys above).
STORAGE_SERVICE=minio
STORAGE_DIR=public
TEMP_URL_LIFETIME=30
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=srvonclick-bucket
MINIO_ENDPOINT=http://localhost:9000
MINIO_URL=
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Optional: PROD_STAGE=false outside production (the bucket name is then part of the object keys),
# RATE_LIMITATION=100 (requests per minute).

# --- Import (the b2r json files the mobile side drops in the bucket) ---
# import-json/booking-data and import-json/application-log are read every five minutes (the scheduler queues the rows,
# `php artisan queue:work` saves them); a file that was read moves to loaded-json.
# GET /api/test-import (super_admin) does the same work right now and returns the imported data.
IMPORT_JSON_ENABLED=true
# IMPORT_JSON=import-json
# BOOKING_DATA_JSON_FOLDER_NAME=booking-data
# APPLICATION_LOG_JSON_FOLDER_NAME=application-log
# LOADED_JSON_FOLDER_NAME=loaded-json
# IMPORT_BOOKING_JSON_CHUNK_SIZE=100
# IMPORT_APPLICATION_LOG_JSON_CHUNK_SIZE=500
# IMPORT_BOOKING_JSON_CRON="*/5 * * * *"
# IMPORT_APPLICATION_LOG_JSON_CRON="1-59/5 * * * *"

# --- Export (the r2b files this system writes back for the mobile side) ---
# The decisions made here (status changes, corrected date/time values) are written to export-json/booking-status and export-json/booking-values
# every two minutes by `exportBookingStatusJson:mysql` (no queue worker needed). EXPORT_JSON_ENABLED=false keeps them waiting in the database.
EXPORT_JSON_ENABLED=true
# The mobile importer reads ONE status file per day by its exact name. Its configuration says r2b, its importer looks for b2r: set the prefix it really reads.
# EXPORT_BOOKING_STATUS_PREFIX=SrvOnClick_r2b_booking_status_
# The day in that file name is counted in this timezone (empty = the application's, UTC): set the one the mobile importer uses, e.g. Asia/Jerusalem.
# EXPORT_JSON_TIMEZONE=
# EXPORT_JSON=export-json
# BOOKING_STATUS_JSON_FOLDER_NAME=booking-status
# BOOKING_VALUES_JSON_FOLDER_NAME=booking-values
# EXPORT_JSON_CRON="*/2 * * * *"
# EXPORT_JSON_MAX_ATTEMPTS=8

# --- The configuration channel (r2b "system_config" files) ---
# Every change of the form structure, the options, the statements, the settings and a new unit is written to export-json/system-config, oldest first, in
# the same round. The mobile side needs an importer for them (docs/mobile-sync-contract.md). With the channel off the changes are kept in the database
# and go out when it is switched on.
SYNC_CONFIG_CHANNEL_ENABLED=true
# SYSTEM_CONFIG_JSON_FOLDER_NAME=system-config

# --- The digital hatch (FTP between this system and the mobile side) ---
# The bucket stays the working area; three scheduler commands (no queue worker) move the files:
#   digital-hatch:send              r2b  bucket -> FTP  SrvOnClick_r2b_booking_status_<date>.json, SrvOnClick_r2b_users_<date>.json (every 2 minutes)
#   digital-hatch:fetch             b2r  FTP -> bucket  SrvOnClick_b2r_export_bookings_<date-time>.json, SrvOnClick_b2r_application_logs_<date-time>.json (every 5)
#   digital-hatch:fetch-attachments b2r  FTP -> bucket  SrvOnClickFiles_<stored name>.<pdf|docx|xlsx|pptx|jpg|png|...> (every 5)
# The fetched files land in import-json/... and import-files/ and are read by the import commands above. Needs the PHP ftp extension.
HATCH_ENABLED=false
HATCH_FTP_HOST=
HATCH_FTP_USERNAME=
HATCH_FTP_PASSWORD=
# FTP_ROOT=
# RED_TO_BLACK_FTP_PATH=/R2B/Tikshoret-R2B-Prod/
# BLACK_TO_RED_FTP_PATH=/Tikshoret-B2R-Prod/
# BLACK_TO_RED_FTP_ATTACHMENTS_PATH=/DigitalFiles-B2R-Prod/
# HATCH_FORMAT=json
# Keep these unless the mobile side renamed its files: the importers look for SrvOnClick_b2r_ and AttachmentService for SrvOnClickFiles_.
# HATCH_PREFIX=SrvOnClick
# HATCH_FILES_PREFIX=SrvOnClickFiles
# USERS_JSON_FOLDER_NAME=users
# DIGITAL_HATCH_SEND_CRON="1-59/2 * * * *"
# DIGITAL_HATCH_FETCH_CRON="3-59/5 * * * *"
# DIGITAL_HATCH_FETCH_ATTACHMENTS_CRON="3-59/5 * * * *"

# --- Files and images of the bookings ---
# The booking json only names them (SrvOnClickFiles_<stored name>, no extension); the bytes are read from this bucket folder. To read the mobile
# app's own backup folder directly when the two share a bucket, set ATTACHMENTS_FOLDER_NAME=export-files.
# ATTACHMENTS_FOLDER_NAME=import-files

VITE_APP_NAME="${APP_NAME}"
