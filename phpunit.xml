<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- The developer's .env must never reach a test: no FTP, and above all no write into a local r2b folder. -->
        <env name="HATCH_ENABLED" value="false"/>
        <env name="HATCH_FTP_HOST" value=""/>
        <env name="DIGITAL_HATCH_EXPORT_PATH" value=""/>
        <env name="DIGITAL_HATCH_IMPORT_PATH" value=""/>
        <env name="DIGITAL_HATCH_IMPORT_FILES_PATH" value=""/>
        <!-- The bucket folders: a .env that renames one must not change what the tests read and write. -->
        <env name="IMPORT_JSON" value="import-json"/>
        <env name="BOOKING_DATA_JSON_FOLDER_NAME" value=""/>
        <env name="APPLICATION_LOG_JSON_FOLDER_NAME" value=""/>
        <env name="LOADED_JSON_FOLDER_NAME" value="loaded-json"/>
        <env name="IMPORT_FILES_FOLDER_NAME" value="import-files"/>
        <env name="LOADED_FILES_FOLDER_NAME" value="loaded-files"/>
        <env name="ATTACHMENTS_FOLDER_NAME" value="files"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
